NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Indexability gate. Until "true", the entire site is noindex'd —
# both via meta tag AND robots.txt. Flip to "true" on the Vercel
# production environment only, once the site is ready to be public.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Resend — every channel is optional; the form uses whichever are configured
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_TO_EMAIL=

# Telegram lead notifications (bot added to your group)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Neon Postgres (optional: leads are also stored here when set)
DATABASE_URL=